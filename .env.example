# ─── SarmayeNama environment ───────────────────────────────────────────────
# Copy to .env and fill in. No real secrets are committed to the repo.

# PostgreSQL (required)
DATABASE_URL=postgresql://sarmaye:sarmaye@localhost:5432/sarmaye

# Iranian market providers (free keys — request at the provider site)
BRSAPI_API_KEY=
NAVASAN_API_KEY=
IRANIAN_STOCKS_ENABLED=false

# Precious metals & global markets
METALSDEV_API_KEY=
ALPHAVANTAGE_API_KEY=
GLOBAL_MARKETS_ENABLED=false

# Crypto (keyless public endpoints work; free demo key optional)
COINGECKO_API_KEY=

# Economic indicators
FRED_API_KEY=
ECONOMIC_INDICATORS_ENABLED=false

# ─── Refresh intervals (ms) ────────────────────────────────────────────────
BRSAPI_INTERVAL_MS=90000
NAVASAN_INTERVAL_MS=600000
TSETMC_INTERVAL_MS=300000
METALS_INTERVAL_MS=21600000
COINGECKO_INTERVAL_MS=300000
FRANKFURTER_INTERVAL_MS=43200000
ALPHAVANTAGE_INTERVAL_MS=86400000
FRED_INTERVAL_MS=86400000

# ─── Daily quota budgets (requests per provider per day) ───────────────────
BRSAPI_DAILY_LIMIT=1500
NAVASAN_DAILY_LIMIT=240
METALSDEV_DAILY_LIMIT=20
ALPHAVANTAGE_DAILY_LIMIT=25
COINGECKO_DAILY_LIMIT=1000

# ─── Aggregation & retention ───────────────────────────────────────────────
AGGREGATE_INTERVAL_MS=300000
SNAPSHOT_RETENTION_DAYS=90
HEALTH_CHECK_INTERVAL_MS=300000

# ─── Circuit breaker ────────────────────────────────────────────────────────
CIRCUIT_FAILURE_THRESHOLD=5
CIRCUIT_COOLDOWN_MS=300000

# ─── Web ───────────────────────────────────────────────────────────────────
ADMIN_SECRET=change-me-admin-secret
WEB_ORIGIN=http://localhost:3000

# ─── Logging ───────────────────────────────────────────────────────────────
LOG_LEVEL=info
LOG_JSON=true

# Market news (free tiers: NewsAPI 100 req/day non-commercial, Brave 2000/month)
NEWS_API_KEY=
NEWS_ENABLED=true
NEWS_INTERVAL_MS=2700000
BRAVE_API_KEY=

# Global markets — US stocks via Finnhub (free: real-time US quotes, 60/min)
FINNHUB_API_KEY=
FINNHUB_INTERVAL_MS=1800000
FINNHUB_DAILY_LIMIT=500

# Energy commodities via EIA (official US daily reference data)
EIA_API_KEY=
EIA_INTERVAL_MS=86400000

# AI market summary (Google Gemini free tier)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_SUMMARIES_ENABLED=true
GEMINI_INTERVAL_MS=1800000
